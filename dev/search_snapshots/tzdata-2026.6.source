{"info":{"author":"Python Software Foundation","author_email":"datetime-sig@python.org","bugtrack_url":null,"classifiers":["Development Status :: 5 - Production/Stable","Intended Audience :: Developers","Programming Language :: Python :: 2","Programming Language :: Python :: 3"],"description":"tzdata: Python package providing IANA time zone data\n====================================================\n\nThis is a Python package containing ``zic``-compiled binaries for the IANA time\nzone database. It is intended to be a fallback for systems that do not have\nsystem time zone data installed (or don't have it installed in a standard\nlocation), as a part of `PEP 615 <https://www.python.org/dev/peps/pep-0615/>`_.\n\nThis repository generates a ``pip``-installable package, published on PyPI as\n`tzdata <https://pypi.org/project/tzdata>`_.\n\nFor more information, see `the documentation <https://tzdata.python.org>`_.\n","description_content_type":"text/x-rst","docs_url":null,"download_url":null,"downloads":{"last_day":-1,"last_month":-1,"last_week":-1},"dynamic":["License-File"],"home_page":"https://github.com/python/tzdata","keywords":null,"license":"Apache-2.0","license_expression":null,"license_files":["LICENSE","licenses/LICENSE_APACHE"],"maintainer":null,"maintainer_email":null,"name":"tzdata","package_url":"https://pypi.org/project/tzdata/","platform":null,"project_url":"https://pypi.org/project/tzdata/","project_urls":{"Bug Reports":"https://github.com/python/tzdata/issues","Documentation":"https://tzdata.python.org","Homepage":"https://github.com/python/tzdata","Source":"https://github.com/python/tzdata"},"provides_extra":null,"release_url":"https://pypi.org/project/tzdata/2026.6/","requires_dist":null,"requires_python":">=2","summary":"Provider of IANA time zone data","version":"2026.6","yanked":false,"yanked_reason":null},"last_serial":42860041,"ownership":{"organization":"python","roles":[{"role":"Owner","user":"pganssle"},{"role":"Owner","user":"stanfromireland"},{"role":"Maintainer","user":"belopolsky"}]},"urls":[{"comment_text":null,"core-metadata":{"sha256":"8173da8700dd125e60c9caf7663d02ee3318851ee60d387b2b080f23a74a86a8"},"digests":{"blake2b_256":"0a669a06c2227fedfd4919f0eaaa8b94377d9730882a7e4f95823c9a331ab5e1","md5":"8da3c932c2caba5365ff6199b95981aa","sha256":"0a10eec6e13ef16b627fabed9a5f2ba61a62b1c67f327305f4e7e412a70b4aec"},"downloads":-1,"filename":"tzdata-2026.6-py2.py3-none-any.whl","has_sig":false,"md5_digest":"8da3c932c2caba5365ff6199b95981aa","packagetype":"bdist_wheel","python_version":"py2.py3","requires_python":">=2","size":348210,"upload_time":"2026-10-28T09:57:07","upload_time_iso_8601":"2026-10-28T09:57:07.276552Z","url":"https://files.pythonhosted.org/packages/0a/66/9a06c2227fedfd4919f0eaaa8b94377d9730882a7e4f95823c9a331ab5e1/tzdata-2026.6-py2.py3-none-any.whl","yanked":false,"yanked_reason":null},{"comment_text":null,"core-metadata":false,"digests":{"blake2b_256":"7a296a1391d31cd00ff9e927215a224a880e1e84e826b64ba80a499e51c074d8","md5":"cae9d274697deecfba4a047ec0eb65f3","sha256":"85d2cd9c09f81f0bb29db27759fc83af4f1e620efb814f8c5bf8b4cc4feece6d"},"downloads":-1,"filename":"tzdata-2026.6.tar.gz","has_sig":false,"md5_digest":"cae9d274697deecfba4a047ec0eb65f3","packagetype":"sdist","python_version":"source","requires_python":">=2","size":201017,"upload_time":"2026-10-28T09:57:09","upload_time_iso_8601":"2026-10-28T09:57:09.137703Z","url":"https://files.pythonhosted.org/packages/7a/29/6a1391d31cd00ff9e927215a224a880e1e84e826b64ba80a499e51c074d8/tzdata-2026.6.tar.gz","yanked":false,"yanked_reason":null}],"vulnerabilities":[]}
